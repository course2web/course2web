# Copy this file to pipeline.env for machine-specific configuration.
# pipeline.env is ignored by Git. Environment variables override this file,
# and command-line arguments override both.

RUN_MODE=dry-run
PROCESS_NOT_BEFORE=2026-08-04
ALLOW_PUBLISH=false

AWS_REGION=us-east-1
S3_BUCKET=www.catholicpatrimony.com
CLOUDFRONT_DISTRIBUTION_ID=

# The rclone remote will be configured with read-only Google Drive access.
GOOGLE_DRIVE_REMOTE=course2web-drive
GOOGLE_DRIVE_UPLOADS_PATH=My Drive/catholic/tedesche/uploads
